// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  USER
}

enum Gender {
  Male
  Female
}

model User {
  id         String        @id @default(uuid())
  name       String
  email      String        @unique
  password   String
  role       Role          @default(USER)
  rememberMe Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  profile    UserProfile?
  security   UserSecurity?

  // Relation to courses (instructor)
  courses   Course[]
  clicks    UserClick[]
  purchases UserPurchase[]
}

model UserClick {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  clickType     String // "course" | "category" | "instructor"
  targetId String // ID of clicked entity (courseId, categoryId, instructorId)
  action   String @default("click") // "click" | "view" | "enroll" | "share"

  // Optional relations (nullable because depends on type)
  courseId     String?
  categoryId   String?
  instructorId String?

  timestamp DateTime @default(now())
  metadata  Json? // flexible storage for ClickMetaData

  @@index([userId, timestamp])
  @@index([targetId, timestamp]) // generic index for popularity/recent activity
  @@index([clickType, targetId])
}

// model Cart{
  
// }

model UserPurchase {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  price     Int
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([courseId, timestamp])
}

model UserProfile {
  id              String    @id @default(uuid())
  contact         String?   @unique
  about           String?
  dob             DateTime?
  gender          Gender?
  profileImg      String?
  profileImgId    String?
  profileBanner   String?
  profileBannerId String?
  profession      String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model UserSecurity {
  id                  String    @id @default(uuid())
  twoStepVerification Boolean?
  lastPasswordChange  DateTime?
  recoveryEmail       String?
  recoveryPhone       String?
  loginAlertsEnabled  Boolean?

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model Course {
  id              String       @id @default(uuid())
  category        String
  createdAt       DateTime     @default(now())
  description     String
  thumbnailUrl    String?
  thumbnailId     String?
  language        String
  level           String
  lengthNum       Int
  lengthStr       String
  objectives      String
  primaryLanguage String
  pricing         Float
  requirements    Json
  searchkey       String
  slug            String       @unique
  status          CourseStatus
  subtitle        String
  title           String
  welcomeMessage  String
  updatedAt       DateTime?    @updatedAt

  purchases UserPurchase[]

  // Relation to User (Instructor)
  instructor   User   @relation(fields: [instructorId], references: [id])
  instructorId String

  // Relations
  sections        Section[] // A course has many sections
  CourseAnalytics CourseAnalytics?

  @@map("courses")
}

model CourseAnalytics {
  id       String @id @default(uuid())
  course   Course @relation(fields: [courseId], references: [id])
  courseId String @unique

  impressions Int      @default(0)
  clicks      Int      @default(0)
  trending    Float    @default(0.0)
  lastUpdated DateTime @updatedAt
}

enum CourseStatus {
  published
  drafted
}

model Section {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())

  // Relations
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  lectures Lecture[] // one-to-many
  order    Int // for drag-and-drop ordering
}

model Resource {
  id    String @id @default(uuid())
  title String
  link  String

  lectureId String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

model Lecture {
  id          String   @id @default(uuid())
  title       String
  freePreview Boolean  @default(false)
  createdAt   DateTime @default(now())

  lengthNum Int? // optional, since PDFs won’t have length
  lengthStr String? // optional, same reason

  // Relations
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])
  order     Int // position within the section

  // Link to assets
  lectureAssets LectureAsset?
  Resource      Resource[]
}

enum LectureAssetStatus {
  published
  pending
  uploading
  failed
}

model LectureAsset {
  id           String             @id @default(uuid())
  title        String
  url          String // Cloudinary/S3 CDN link
  publicId     String // object key for deletion/management
  type         AssetType
  createdAt    DateTime           @default(now())
  status       LectureAssetStatus @default(pending)
  thumbnailUrl String?

  // Relation
  lectureId String  @unique
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

enum AssetType {
  VIDEO
  PDF
}
