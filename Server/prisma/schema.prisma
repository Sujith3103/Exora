model UserClick {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  clickType String // "course" | "category" | "instructor"
  targetId  String // ID of clicked entity (courseId, categoryId, instructorId)
  action    String @default("click") // "click" | "view" | "enroll" | "share"

  // Optional relations (nullable because depends on type)
  courseId     String?
  categoryId   String?
  instructorId String?

  timestamp DateTime @default(now())
  metadata  Json? // flexible storage for ClickMetaData

  @@index([userId, timestamp])
  @@index([targetId, timestamp]) // generic index for popularity/recent activity
  @@index([clickType, targetId])
}

model UserPurchase {
  id     String @id @default(cuid()) // Unique purchase ID
  user   User   @relation("studentPurchase", fields: [userId], references: [id]) // Who bought
  userId String

  course   Course @relation(fields: [courseId], references: [id]) // What course
  courseId String

  price     Decimal  @db.Decimal(10, 2)
  timestamp DateTime @default(now()) // When purchase happened

  @@index([userId, timestamp]) // For querying purchases per user over time
  @@index([courseId, timestamp]) // For querying purchases per course over time
}

model UserProfile {
  id              String    @id @default(uuid())
  contact         String?   @unique
  about           String?
  dob             DateTime?
  gender          Gender?
  profileImg      String?
  profileImgId    String?
  profileBanner   String?
  profileBannerId String?
  profession      String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model UserSecurity {
  id                  String    @id @default(uuid())
  twoStepVerification Boolean?
  lastPasswordChange  DateTime?
  recoveryEmail       String?
  recoveryPhone       String?
  loginAlertsEnabled  Boolean?

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model Course {
  id                     String       @id @default(uuid())
  category               String
  createdAt              DateTime     @default(now())
  description            String
  thumbnailUrl           String?
  thumbnailId            String?
  language               String
  level                  String
  lengthNum              Int
  lengthStr              String 
  objectives             String
  primaryLanguage        String
  pricing                Float
  requirements           Json
  searchkey              String
  slug                   String       @unique
  status                 CourseStatus
  subtitle               String
  title                  String
  welcomeMessage         String
  congradulationsMessage String?
  updatedAt              DateTime?    @updatedAt

  purchases UserPurchase[]

  // Relation to User (Instructor)
  instructor   User   @relation(fields: [instructorId], references: [id])
  instructorId String

  // Relations
  sections               Section[] // A course has many sections
  CourseAnalytics        CourseAnalytics?
  courseRevenueAnalytics CourseRevenueAnalytics?
  revenueHistory         CourseRevenueHistory[]

  @@map("courses")
}

enum DiscountType {
  percentage
  fixed
}

enum OnlyFor {
  tier_1
  tier_2
  tier_3
}

enum ApplyTo {
  allCourses
  oneCourse
}

model Coupon {
  id                String              @id @default(uuid())
  title             String
  code              String              @unique
  discountType      DiscountType
  discount          Int
  noOfCoupons       Int
  limitPerUser      Int
  onlyFor           OnlyFor
  autoApply         Boolean
  timesUsed         Int                 @default(0)
  timesApplied      Int?                @default(0)
  totalRevenue      Int
  courseId          String
  applyTo           ApplyTo
  validUntil        DateTime
  validFrom         DateTime            @default(now())
  user              User                @relation(fields: [userId], references: [id])
  userId            String
  CouponApplication CouponApplication[]
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  courseId  String
  status    String // "REDEEMED"
  createdAt DateTime @default(now())
}

model CouponApplication {
  id       String   @id @default(uuid())
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  couponId String
  month    DateTime

  user   User?   @relation("StudentApplications", fields: [userId], references: [id])
  userId String?

  instructor   User   @relation("InstructorApplications", fields: [instructorId], references: [id])
  instructorId String

  revenue      Int                     @default(0)
  appliedAt    DateTime                @default(now())
  orderId      String? // null if user never checked out
  status       CouponApplicationStatus @default(APPLIED)
  appliedCount Int                     @default(0)

  @@unique([couponId, month, status])
}

enum CouponApplicationStatus {
  APPLIED // user applied coupon
  REDEEMED // user completed checkout
  ABANDONED // user applied but never purchased
}

model CourseAnalytics {
  id       String @id @default(uuid())
  course   Course @relation(fields: [courseId], references: [id])
  courseId String @unique

  impressions Int      @default(0)
  clicks      Int      @default(0)
  trending    Float    @default(0.0)
  lastUpdated DateTime @updatedAt
}

model CourseRevenueAnalytics {
  id       String @id @default(uuid())
  course   Course @relation(fields: [courseId], references: [id])
  courseId String @unique

  instructorId           String
  totalRevenue           Int      @default(0) // sum of purchases
  totalEnrolls           Int      @default(0) // count of purchases
  totalDiscountedRevenue Int      @default(0)
  lastUpdated            DateTime @updatedAt
}

model CourseRevenueHistory {
  id       String @id @default(uuid())
  courseId String
  Course   Course @relation(fields: [courseId], references: [id])

  instructorId     String
  date             DateTime
  revenue          Int      @default(0)
  enrollments      Int      @default(0)
  dicountedRevenue Int      @default(0)

  @@unique([courseId, date]) // ✅ only this
}

model UserLectureProgress {
  id         String   @id @default(uuid())
  userId     String
  lectureId  String
  courseId   String
  watchedSec Int      @default(0)   // tracked seconds for resume
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  lecture Lecture @relation(fields: [lectureId], references: [id])

  @@unique([userId, lectureId])
  @@index([userId, courseId])
}

model CourseProgress {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  completed  Boolean  @default(false)
  completedAt DateTime?

  @@unique([userId, courseId])
}


enum CourseStatus {
  published
  drafted
}

model Section {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())

  // Relations
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  lectures Lecture[] // one-to-many
  order    Int // for drag-and-drop ordering
}

model Resource {
  id    String @id @default(uuid())
  title String
  link  String

  lectureId String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

model Lecture {
  id          String   @id @default(uuid())
  title       String
  freePreview Boolean  @default(false)
  createdAt   DateTime @default(now())

  lengthNum Int? // optional, since PDFs won’t have length
  lengthStr String? // optional, same reason

  // Relations
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])
  order     Int // position within the section

  // Link to assets
  lectureProgress UserLectureProgress[]
  lectureAssets LectureAsset?
  Resource      Resource[]
}

enum LectureAssetStatus {
  published
  pending
  uploading
  failed
}

model LectureAsset {
  id           String             @id @default(uuid())
  title        String
  url          String // Cloudinary/S3 CDN link
  publicId     String // object key for deletion/management
  type         AssetType
  createdAt    DateTime           @default(now())
  status       LectureAssetStatus @default(pending)
  thumbnailUrl String?

  // Relation
  lectureId String  @unique
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

enum AssetType {
  VIDEO
  PDF
}
