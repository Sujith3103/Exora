// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  USER
  DEVELOPER
}

enum Gender {
  Male
  Female
}

model User {
  id         String        @id @default(uuid())
  name       String
  email      String        @unique
  password   String
  role       Role          @default(USER)
  rememberMe Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  profile    UserProfile?
  security   UserSecurity?

  usersomehing                 String?
  // Relation to courses (instructor)
  courses                      Course[]
  clicks                       UserClick[]
  // purchases         UserPurchase[]
  cart                         Cart?
  cartId                       String?
  coupons                      Coupon[]
  studentCouponApplications    CouponApplication[] @relation("StudentApplications")
  instructorCouponApplications CouponApplication[] @relation("InstructorApplications")

  lectureProgress UserLectureProgress[]

  UserPurchase UserPurchase[] @relation("studentPurchase")
  // conversations           Conversation[]
  ConversationParticipant ConversationParticipant[]
  messages     Message[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  deviceId   String
  userAgent  String
  ipAddress  String
  expiresAt  DateTime
  revoked    Boolean  @default(false)

  @@index([userId])
}

// Prisma Example (SQL-based)
model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User?  @relation(fields: [userId], references: [id])

  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum CartItemStatus {
  ACTIVE // currently in cart
  SAVED_LATER // saved for later
  REMOVED // optional, to keep history
}

model CartItem {
  id String @id @default(uuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  something     String?
  courseId      String // reference course, but not a relation since we snapshot data
  quantity      Int     @default(1)
  price         Float // snapshot price when added
  discountPrice Float?

  status CartItemStatus @default(ACTIVE)

  title          String
  thumbnailUrl   String
  instructorName String

  addedAt DateTime @default(now())

  @@unique([cartId, courseId]) // 👈 ensures no duplicate course in a single cart
}

model Message {
  id             String @id @default(uuid())
  conversationId String
  senderId       String
  content        String

  automatedMessage Boolean?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
}

model ConversationParticipant {
  id String @id @default(uuid())

  conversationId  String
  user User @relation(fields: [userId] , references: [id])
  userId          String
  lastMessageRead Boolean
  messageReplied Boolean
  isImportant       Boolean

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Participants
  // participants ConversationParticipant[]
  messages                Message[]
  conversationParticipant ConversationParticipant[]
  // User         User?                     @relation(fields: [userId], references: [id])
  userId                  String?
}

model DeadLetterQueue {
  eventId       String   @id @unique
  eventMetaData Json?
  eventType     EventType

  status        DLQStatus
  error         String?

  failedAt      DateTime
  retryCount    Int      // auto retry count (1–5)

  attempts      RetryAttempt[]  // relation
}

enum DLQStatus {
  failed
  success
}

enum EventType {
  notification
  message
}

model RetryAttempt {
  id          String   @id @default(uuid())

  eventId     String
  dlq         DeadLetterQueue @relation(fields: [eventId], references: [eventId])

  attemptType AttemptType   // AUTO | FINAL | MANUAL

  attemptNo   Int           // 1,2,3,4,5... (very important)
  status      AttemptStatus // SUCCESS | FAILED

  error       String?
  executedAt  DateTime      @default(now())

  metadata    Json?         // optional (payload snapshot, debug info)
}

enum AttemptType {
  AUTO
  FINAL   // 5th retry
  MANUAL
}

enum AttemptStatus {
  SUCCESS
  FAILED
}


