generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String                    @id @default(uuid())
  name                         String
  email                        String                    @unique
  createdAt                    DateTime                  @default(now())
  password                     String
  role                         Role                      @default(USER)
  updatedAt                    DateTime                  @updatedAt
  rememberMe                   Boolean                   @default(false)
  cartId                       String?
  usersomehing                 String?
  cart                         Cart?
  ConversationParticipant      ConversationParticipant[]
  coupons                      Coupon[]
  instructorCouponApplications CouponApplication[]       @relation("InstructorApplications")
  studentCouponApplications    CouponApplication[]       @relation("StudentApplications")
  Message                      Message[]
  clicks                       UserClick[]
  UserLectureProgress          UserLectureProgress[]
  profile                      UserProfile?
  UserPurchase                 UserPurchase[]            @relation("studentPurchase")
  security                     UserSecurity?
  courses                      Course[]
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id             String         @id @default(uuid())
  cartId         String
  courseId       String
  quantity       Int            @default(1)
  price          Float
  discountPrice  Float?
  title          String
  thumbnailUrl   String
  instructorName String
  addedAt        DateTime       @default(now())
  status         CartItemStatus @default(ACTIVE)
  something      String?
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, courseId])
}

model UserClick {
  id           String   @id @default(cuid())
  userId       String
  courseId     String?
  timestamp    DateTime @default(now())
  action       String   @default("click")
  categoryId   String?
  instructorId String?
  metadata     Json?
  targetId     String
  clickType    String
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
  @@index([targetId, timestamp])
  @@index([clickType, targetId])
}

model UserPurchase {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  price     Decimal  @db.Decimal(10, 2)
  timestamp DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation("studentPurchase", fields: [userId], references: [id])

  @@index([userId, timestamp])
  @@index([courseId, timestamp])
}

model UserProfile {
  id              String    @id @default(uuid())
  contact         String?   @unique
  about           String?
  dob             DateTime?
  gender          Gender?
  profession      String?
  userId          String    @unique
  profileBanner   String?
  profileBannerId String?
  profileImg      String?
  profileImgId    String?
  user            User      @relation(fields: [userId], references: [id])
}

model UserSecurity {
  id                  String    @id @default(uuid())
  twoStepVerification Boolean?
  lastPasswordChange  DateTime?
  recoveryEmail       String?
  recoveryPhone       String?
  loginAlertsEnabled  Boolean?
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
}

model Course {
  id                     String                  @id @default(uuid())
  title                  String
  category               String
  level                  String
  primaryLanguage        String
  subtitle               String
  language               String
  description            String
  pricing                Float
  objectives             String
  welcomeMessage         String
  requirements           Json
  searchkey              String
  slug                   String                  @unique
  createdAt              DateTime                @default(now())
  lengthNum              Int
  lengthStr              String
  status                 CourseStatus
  instructorId           String
  thumbnailId            String?
  thumbnailUrl           String?
  updatedAt              DateTime?               @updatedAt
  congradulationsMessage String?
  CourseAnalytics        CourseAnalytics?
  courseRevenueAnalytics CourseRevenueAnalytics?
  revenueHistory         CourseRevenueHistory[]
  sections               Section[]
  purchases              UserPurchase[]
  instructor             User                    @relation(fields: [instructorId], references: [id])

  @@map("courses")
}

model Coupon {
  id                String              @id @default(uuid())
  title             String
  code              String              @unique
  discountType      DiscountType
  noOfCoupons       Int
  limitPerUser      Int
  onlyFor           OnlyFor
  autoApply         Boolean
  totalRevenue      Int
  applyTo           ApplyTo
  validUntil        DateTime
  validFrom         DateTime            @default(now())
  userId            String
  discount          Int
  courseId          String
  timesUsed         Int                 @default(0)
  timesApplied      Int?                @default(0)
  user              User                @relation(fields: [userId], references: [id])
  CouponApplication CouponApplication[]
}

model CouponApplication {
  id           String                  @id @default(uuid())
  couponId     String
  userId       String?
  appliedAt    DateTime                @default(now())
  orderId      String?
  status       CouponApplicationStatus @default(APPLIED)
  month        DateTime
  appliedCount Int                     @default(0)
  instructorId String
  revenue      Int                     @default(0)
  coupon       Coupon                  @relation(fields: [couponId], references: [id])
  instructor   User                    @relation("InstructorApplications", fields: [instructorId], references: [id])
  user         User?                   @relation("StudentApplications", fields: [userId], references: [id])

  @@unique([couponId, month, status])
}

model CourseAnalytics {
  id          String   @id @default(uuid())
  courseId    String   @unique
  impressions Int      @default(0)
  clicks      Int      @default(0)
  trending    Float    @default(0.0)
  lastUpdated DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id])
}

model CourseRevenueAnalytics {
  id                     String   @id @default(uuid())
  courseId               String   @unique
  totalRevenue           Int      @default(0)
  totalEnrolls           Int      @default(0)
  lastUpdated            DateTime @updatedAt
  instructorId           String
  totalDiscountedRevenue Int      @default(0)
  course                 Course   @relation(fields: [courseId], references: [id])
}

model CourseRevenueHistory {
  id               String   @id @default(uuid())
  courseId         String
  revenue          Int      @default(0)
  enrollments      Int      @default(0)
  date             DateTime
  dicountedRevenue Int      @default(0)
  instructorId     String
  Course           Course   @relation(fields: [courseId], references: [id])

  @@unique([courseId, date], name: "courseId_date")
}

model Section {
  id        String    @id @default(uuid())
  title     String
  createdAt DateTime  @default(now())
  courseId  String
  order     Int
  lectures  Lecture[]
  course    Course    @relation(fields: [courseId], references: [id])
}

model Resource {
  id        String  @id @default(uuid())
  title     String
  link      String
  lectureId String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

model Lecture {
  id                  String                @id @default(uuid())
  title               String
  freePreview         Boolean               @default(false)
  lengthNum           Int?
  lengthStr           String?
  createdAt           DateTime              @default(now())
  sectionId           String
  order               Int
  section             Section               @relation(fields: [sectionId], references: [id])
  lectureAssets       LectureAsset?
  Resource            Resource[]
  UserLectureProgress UserLectureProgress[]
}

model LectureAsset {
  id           String             @id @default(uuid())
  title        String
  url          String
  publicId     String
  type         AssetType
  createdAt    DateTime           @default(now())
  lectureId    String             @unique
  status       LectureAssetStatus @default(pending)
  thumbnailUrl String?
  lecture      Lecture            @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

model CouponRedemption {
  id        String   @id
  couponId  String
  userId    String
  courseId  String
  status    String
  createdAt DateTime @default(now())
}

model Conversation {
  id                      String                    @id
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  userId                  String?
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]
}

model ConversationParticipant {
  id              String       @id
  conversationId  String
  userId          String
  lastMessageRead Boolean
  isImportant     Boolean
  messageReplied  Boolean
  Conversation    Conversation @relation(fields: [conversationId], references: [id])
  User            User         @relation(fields: [userId], references: [id])
}

model CourseProgress {
  id          String    @id
  userId      String
  courseId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, courseId])
}

model DeadLetterQueue {
  eventId       String    @id @unique
  retryCount    Int
  failedAt      DateTime
  eventType     EventType
  error         String?
  status        DLQStatus
  eventMetaData Json?
}

model Message {
  id               String       @id
  conversationId   String
  senderId         String
  content          String
  automatedMessage Boolean?
  createdAt        DateTime     @default(now())
  Conversation     Conversation @relation(fields: [conversationId], references: [id])
  User             User         @relation(fields: [senderId], references: [id])
}

model RefreshToken {
  id        String   @id
  userId    String
  tokenHash String   @unique
  deviceId  String
  userAgent String
  ipAddress String
  expiresAt DateTime
  revoked   Boolean  @default(false)

  @@index([userId])
}

model UserLectureProgress {
  id         String   @id
  userId     String
  lectureId  String
  courseId   String
  watchedSec Int      @default(0)
  completed  Boolean  @default(false)
  updatedAt  DateTime
  createdAt  DateTime @default(now())
  Lecture    Lecture  @relation(fields: [lectureId], references: [id])
  User       User     @relation(fields: [userId], references: [id])

  @@unique([userId, lectureId])
  @@index([userId, courseId])
}

enum Role {
  ADMIN
  INSTRUCTOR
  USER
  DEVELOPER
}

enum Gender {
  Male
  Female
}

enum CartItemStatus {
  ACTIVE
  SAVED_LATER
  REMOVED
}

enum DiscountType {
  percentage
  fixed
}

enum OnlyFor {
  tier_1
  tier_2
  tier_3
}

enum ApplyTo {
  allCourses
  oneCourse
}

enum CouponApplicationStatus {
  APPLIED
  REDEEMED
  ABANDONED
}

enum CourseStatus {
  published
  drafted
}

enum LectureAssetStatus {
  published
  pending
  uploading
  failed
}

enum AssetType {
  VIDEO
  PDF
}

enum DLQStatus {
  failed
  success
}

enum EventType {
  notification
  message
}
